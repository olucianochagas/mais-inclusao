{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mais-inclusao/eslint-config",
  "version": "0.1.0",
  "private": true,
  "description": "ESLint 9 flat config presets compartilhados do monorepo +Inclusão.",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@eslint/js": "^9.16.0",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-security": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "^15.13.0",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@mais-inclusao/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "tsup": "catalog:"
  }
}
