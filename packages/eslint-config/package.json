{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mais-inclusao/eslint-config",
  "version": "0.1.0",
  "private": true,
  "description": "ESLint 9 flat config presets compartilhados do monorepo +Inclusão.",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./nest": "./src/nest.js",
    "./react": "./src/react.js",
    "./lib": "./src/lib.js"
  },
  "files": [ "src", "README.md" ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@eslint/js": "^9.16.0",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-security": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "^15.13.0",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@mais-inclusao/tsconfig": "workspace:*"
  }
}
