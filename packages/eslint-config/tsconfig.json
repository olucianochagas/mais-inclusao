{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mais-inclusao/tsconfig/lib.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "composite": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist/**", "node_modules/**"]
}
